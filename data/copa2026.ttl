# ============================================================================
# A-BOX 2/6 - COMPETICAO: 6 confederacoes, 12 grupos, 48 selecoes
# ============================================================================

copa:conf_AFC a copa:Confederacao ; rdfs:label "AFC" ; rdfs:comment "Confederação Asiática de Futebol" .
copa:conf_CAF a copa:Confederacao ; rdfs:label "CAF" ; rdfs:comment "Confederação Africana de Futebol" .
copa:conf_CONCACAF a copa:Confederacao ; rdfs:label "CONCACAF" ; rdfs:comment "Confederação de Futebol da América do Norte, Central e Caribe" .
copa:conf_CONMEBOL a copa:Confederacao ; rdfs:label "CONMEBOL" ; rdfs:comment "Confederação Sul-Americana de Futebol" .
copa:conf_OFC a copa:Confederacao ; rdfs:label "OFC" ; rdfs:comment "Confederação de Futebol da Oceania" .
copa:conf_UEFA a copa:Confederacao ; rdfs:label "UEFA" ; rdfs:comment "União das Associações Europeias de Futebol" .

copa:grupo_A a copa:Grupo ; rdfs:label "Grupo A" ; copa:letraGrupo "A" .
copa:grupo_B a copa:Grupo ; rdfs:label "Grupo B" ; copa:letraGrupo "B" .
copa:grupo_C a copa:Grupo ; rdfs:label "Grupo C" ; copa:letraGrupo "C" .
copa:grupo_D a copa:Grupo ; rdfs:label "Grupo D" ; copa:letraGrupo "D" .
copa:grupo_E a copa:Grupo ; rdfs:label "Grupo E" ; copa:letraGrupo "E" .
copa:grupo_F a copa:Grupo ; rdfs:label "Grupo F" ; copa:letraGrupo "F" .
copa:grupo_G a copa:Grupo ; rdfs:label "Grupo G" ; copa:letraGrupo "G" .
