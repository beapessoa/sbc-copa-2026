copa:cidade_monterrey a copa:CidadeSede ; rdfs:label "Monterrey" ; copa:localizadoEm copa:pais_MEX .
copa:cidade_nova_york_nova_jersey a copa:CidadeSede ; rdfs:label "Nova York/Nova Jersey" ; copa:localizadoEm copa:pais_USA .
copa:cidade_seattle a copa:CidadeSede ; rdfs:label "Seattle" ; copa:localizadoEm copa:pais_USA .
copa:cidade_sao_francisco a copa:CidadeSede ; rdfs:label "São Francisco" ; copa:localizadoEm copa:pais_USA .
copa:cidade_toronto a copa:CidadeSede ; rdfs:label "Toronto" ; copa:localizadoEm copa:pais_CAN .
copa:cidade_vancouver a copa:CidadeSede ; rdfs:label "Vancouver" ; copa:localizadoEm copa:pais_CAN .

