# Base de conhecimento da Copa do Mundo FIFA de 2026
# Mini-Projeto 3 - Sistemas Baseados em Conhecimento
#
# Dados reais extraidos da Wikipedia (en.wikipedia.org) em julho de 2026:
#   - 2026 FIFA World Cup            (sedes, estadios, capacidades)
#   - 2026 FIFA World Cup squads     (elencos: numero, posicao, nascimento, clube)
#   - 2026 FIFA World Cup round of 32 / knockout stage / final  (partidas)
#   - 2026 FIFA World Cup Group A    (partidas da fase de grupos)

@prefix copa: <http://ufpb.br/sbc/copa2026#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://ufpb.br/sbc/copa2026> a owl:Ontology ;
    rdfs:label "Ontologia da Copa do Mundo FIFA de 2026" ;
    rdfs:comment "Modela selecoes, grupos, confederacoes, cidades-sede, estadios, pessoas (jogadores, tecnicos e arbitros) e partidas da Copa do Mundo de 2026." .

# ============================================================================
# T-BOX 1/3 - HIERARQUIA DE CLASSES (rdfs:subClassOf)
# ============================================================================


# Raiz 1 - Pessoa

copa:Pessoa a owl:Class ;
    rdfs:label "Pessoa" ;
    rdfs:comment "Qualquer ser humano que participa do torneio." .

copa:Jogador a owl:Class ;
    rdfs:label "Jogador" ;
    rdfs:subClassOf copa:Pessoa ;
    rdfs:comment "Atleta convocado por uma selecao." .

copa:Goleiro a owl:Class ;
    rdfs:label "Goleiro" ;
    rdfs:subClassOf copa:Jogador ;
    rdfs:comment "Jogador que atua na meta (GK)." .

copa:Defensor a owl:Class ;
    rdfs:label "Defensor" ;
    rdfs:subClassOf copa:Jogador ;
    rdfs:comment "Jogador de linha defensiva (DF)." .

copa:MeioCampista a owl:Class ;
    rdfs:label "MeioCampista" ;
    rdfs:subClassOf copa:Jogador ;
    rdfs:comment "Jogador de meio-campo (MF)." .

copa:Atacante a owl:Class ;
    rdfs:label "Atacante" ;
    rdfs:subClassOf copa:Jogador ;
    rdfs:comment "Jogador de ataque (FW)." .

copa:Tecnico a owl:Class ;
    rdfs:label "Tecnico" ;
    rdfs:subClassOf copa:Pessoa ;
    rdfs:comment "Treinador responsavel por uma selecao." .

copa:Arbitro a owl:Class ;
    rdfs:label "Arbitro" ;
    rdfs:subClassOf copa:Pessoa ;
    rdfs:comment "Arbitro principal designado para uma partida." .

# Raiz 2 - Local

copa:Local a owl:Class ;
    rdfs:label "Local" ;
    rdfs:comment "Qualquer lugar geografico do torneio." .

copa:Pais a owl:Class ;
    rdfs:label "Pais" ;
    rdfs:subClassOf copa:Local ;
    rdfs:comment "Pais-sede da competicao." .

copa:Cidade a owl:Class ;
    rdfs:label "Cidade" ;
    rdfs:subClassOf copa:Local ;
    rdfs:comment "Municipio ou area metropolitana." .

copa:CidadeSede a owl:Class ;
    rdfs:label "CidadeSede" ;
    rdfs:subClassOf copa:Cidade ;
    rdfs:comment "Cidade escolhida pela FIFA para receber partidas." .

copa:Estadio a owl:Class ;
    rdfs:label "Estadio" ;
    rdfs:subClassOf copa:Local ;
    rdfs:comment "Praca esportiva onde as partidas sao disputadas." .

# Raiz 3 - Partida

copa:Partida a owl:Class ;
    rdfs:label "Partida" ;
    rdfs:comment "Jogo entre duas selecoes." .

copa:PartidaFaseGrupos a owl:Class ;
    rdfs:label "PartidaFaseGrupos" ;
    rdfs:subClassOf copa:Partida ;
    rdfs:comment "Partida da primeira fase, dentro de um grupo." .

copa:PartidaMataMata a owl:Class ;
    rdfs:label "PartidaMataMata" ;
    rdfs:subClassOf copa:Partida ;
    rdfs:comment "Partida eliminatoria: quem perde esta fora." .

copa:Partida16Avos a owl:Class ;
    rdfs:label "Partida16Avos" ;
    rdfs:subClassOf copa:PartidaMataMata ;
    rdfs:comment "Primeira rodada eliminatoria: com 48 selecoes o mata-mata comeca aqui." .

copa:PartidaOitavas a owl:Class ;
    rdfs:label "PartidaOitavas" ;
    rdfs:subClassOf copa:PartidaMataMata ;
    rdfs:comment "Oitavas de final." .

copa:PartidaQuartas a owl:Class ;
    rdfs:label "PartidaQuartas" ;
    rdfs:subClassOf copa:PartidaMataMata ;
    rdfs:comment "Quartas de final." .

copa:PartidaSemifinal a owl:Class ;
    rdfs:label "PartidaSemifinal" ;
    rdfs:subClassOf copa:PartidaMataMata ;
    rdfs:comment "Semifinal." .

copa:PartidaTerceiroLugar a owl:Class ;
    rdfs:label "PartidaTerceiroLugar" ;
    rdfs:subClassOf copa:PartidaMataMata ;
    rdfs:comment "Disputa do terceiro lugar." .

copa:PartidaFinal a owl:Class ;
    rdfs:label "PartidaFinal" ;
    rdfs:subClassOf copa:PartidaMataMata ;
    rdfs:comment "Decisao do titulo." .

# Raiz 4 - Entidades organizacionais

copa:Selecao a owl:Class ;
    rdfs:label "Selecao" ;
    rdfs:comment "Equipe nacional filiada a uma confederacao." .

copa:Semifinalista a owl:Class ;
    rdfs:label "Semifinalista" ;
    rdfs:subClassOf copa:Selecao ;
    rdfs:comment "Classe derivada, sem instancia no arquivo: povoada em execucao pela regra INSERT ... WHERE da Parte 2." .

copa:Grupo a owl:Class ;
    rdfs:label "Grupo" ;
    rdfs:comment "Chave da fase de grupos (A a L)." .

copa:Confederacao a owl:Class ;
    rdfs:label "Confederacao" ;
    rdfs:comment "Confederacao continental filiada a FIFA." .


# ============================================================================
# T-BOX 2/3 - CONSTRUCOES OWL SOBRE CLASSES
# ============================================================================

# Sao 7 construcoes OWL, numeradas de OWL 1 a OWL 7 ao longo do arquivo.
# As duas sobre classes ficam aqui; as cinco sobre propriedades ficam na
# secao seguinte, junto da propriedade afetada.

# OWL 1 - owl:equivalentClass
# 'Mata-mata' e 'fase eliminatoria' nomeiam o mesmo conceito na imprensa e nos
# documentos da FIFA. A equivalencia integra uma base que use o outro termo.
copa:PartidaEliminatoria a owl:Class ;
    rdfs:label "PartidaEliminatoria" ;
    owl:equivalentClass copa:PartidaMataMata ;
    rdfs:comment "Sinonimo de PartidaMataMata usado pela imprensa esportiva." .

# OWL 2 - owl:disjointWith
# Ninguem ocupa duas posicoes em campo, nem e jogador e arbitro da mesma
# competicao. A disjuncao torna esse erro detectavel pelo reasoner - RDFS
# sozinho nao expressa isso.
copa:Goleiro owl:disjointWith copa:Defensor .
copa:Goleiro owl:disjointWith copa:MeioCampista .
copa:Goleiro owl:disjointWith copa:Atacante .
copa:Defensor owl:disjointWith copa:MeioCampista .
copa:Defensor owl:disjointWith copa:Atacante .
copa:MeioCampista owl:disjointWith copa:Atacante .
copa:Jogador owl:disjointWith copa:Arbitro .
copa:Jogador owl:disjointWith copa:Tecnico .
copa:Tecnico owl:disjointWith copa:Arbitro .


# ============================================================================
# T-BOX 3/3 - PROPRIEDADES (12 de objeto + 14 de dados)
# ============================================================================

# Todas declaram rdfs:domain e rdfs:range. Em RDFS esses construtores nao
# validam dado, inferem o tipo do sujeito e do objeto.
# Os rotulos usam rdfs:label, sem domain: dois rdfs:domain numa mesma
# propriedade significariam intersecao de classes, nao uniao.


# --- Propriedades de objeto (12) -------------------------------------------

copa:jogaPor a owl:ObjectProperty ;
    rdfs:label "jogaPor" ;
    rdfs:domain copa:Jogador ;
    rdfs:range copa:Selecao ;
    rdfs:comment "Convocacao: liga o atleta a selecao que o convocou." .

copa:temJogador a owl:ObjectProperty ;
    rdfs:label "temJogador" ;
    rdfs:domain copa:Selecao ;
    rdfs:range copa:Jogador ;
    rdfs:comment "Elenco da selecao. Nao escrita no arquivo: inferida de copa:jogaPor." .

copa:treina a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "treina" ;
    rdfs:domain copa:Tecnico ;
    rdfs:range copa:Selecao ;
    rdfs:comment "Funcional: um tecnico comanda no maximo uma selecao no torneio." .

copa:pertenceAoGrupo a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "pertenceAoGrupo" ;
    rdfs:domain copa:Selecao ;
    rdfs:range copa:Grupo ;
    rdfs:comment "Funcional: cada selecao foi sorteada em exatamente um grupo." .

copa:filiadaA a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "filiadaA" ;
    rdfs:domain copa:Selecao ;
    rdfs:range copa:Confederacao ;
    rdfs:comment "Funcional: cada selecao pertence a uma unica confederacao continental." .

copa:mandante a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "mandante" ;
    rdfs:domain copa:Partida ;
    rdfs:range copa:Selecao ;
    rdfs:comment "Selecao listada em primeiro lugar na tabela oficial da partida." .

copa:visitante a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "visitante" ;
    rdfs:domain copa:Partida ;
    rdfs:range copa:Selecao ;
    rdfs:comment "Selecao listada em segundo lugar na tabela oficial da partida." .

copa:sediadaEm a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "sediadaEm" ;
    rdfs:domain copa:Partida ;
    rdfs:range copa:Estadio ;
    rdfs:comment "Funcional: uma partida acontece em exatamente um estadio." .

copa:vencedora a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "vencedora" ;
    rdfs:domain copa:Partida ;
    rdfs:range copa:Selecao ;
    rdfs:comment "Funcional: quem avancou. Ausente nos empates da fase de grupos." .

copa:apitou a owl:ObjectProperty ;
    rdfs:label "apitou" ;
    rdfs:domain copa:Arbitro ;
    rdfs:range copa:Partida ;
    rdfs:comment "Arbitro principal designado para a partida." .

# OWL 3 - owl:inverseOf
# So o lado jogador -> selecao e escrito (208 triplas). O reasoner deriva o
# elenco de cada selecao; nenhuma tripla copa:temJogador existe no arquivo.
copa:jogaPor owl:inverseOf copa:temJogador .

# OWL 4 - owl:TransitiveProperty
# So os elos curtos sao escritos: estadio -> cidade, cidade -> pais. Sem a
# transitividade, o vinculo com o pais teria de ser repetido em cada estadio.
copa:localizadoEm a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "localizadoEm" ;
    rdfs:domain copa:Local ;
    rdfs:range copa:Local ;
    rdfs:comment "Transitiva: Estadio -> CidadeSede -> Pais implica Estadio -> Pais." .

# OWL 5 - owl:SymmetricProperty
# Se A enfrentou B, B enfrentou A: a simetria evita gravar as duas direcoes.
# Sem instancia no arquivo - a consulta CONSTRUCT da Parte 2 emite a direcao
# mandante -> visitante e o reasoner deriva a inversa.
copa:enfrentou a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "enfrentou" ;
    rdfs:domain copa:Selecao ;
    rdfs:range copa:Selecao ;
    rdfs:comment "Simetrica: duas selecoes que ja se cruzaram no torneio." .


# --- Propriedades de dados (14) --------------------------------------------

copa:numeroCamisa a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "numeroCamisa" ;
    rdfs:domain copa:Jogador ;
    rdfs:range xsd:integer ;
    rdfs:comment "Funcional: um jogador usa um unico numero durante todo o torneio." .

copa:dataNascimento a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "dataNascimento" ;
    rdfs:domain copa:Pessoa ;
    rdfs:range xsd:date ;
    rdfs:comment "Funcional: uma pessoa nasce uma vez so." .

copa:clubeAtual a owl:DatatypeProperty ;
    rdfs:label "clubeAtual" ;
    rdfs:domain copa:Jogador ;
    rdfs:range xsd:string ;
    rdfs:comment "Clube em que o jogador atuava no momento da convocacao." .

copa:jogosPelaSelecao a owl:DatatypeProperty ;
    rdfs:label "jogosPelaSelecao" ;
    rdfs:domain copa:Jogador ;
    rdfs:range xsd:integer ;
    rdfs:comment "Partidas oficiais pela selecao ate o inicio da Copa." .

copa:golsPelaSelecao a owl:DatatypeProperty ;
    rdfs:label "golsPelaSelecao" ;
    rdfs:domain copa:Jogador ;
    rdfs:range xsd:integer ;
    rdfs:comment "Gols oficiais pela selecao ate o inicio da Copa." .

copa:paisDeOrigem a owl:DatatypeProperty ;
    rdfs:label "paisDeOrigem" ;
    rdfs:domain copa:Arbitro ;
    rdfs:range xsd:string ;
    rdfs:comment "Federacao nacional a que o arbitro e filiado." .

copa:capacidade a owl:DatatypeProperty ;
    rdfs:label "capacidade" ;
    rdfs:domain copa:Estadio ;
    rdfs:range xsd:integer ;
    rdfs:comment "Publico maximo do estadio na configuracao usada pela FIFA." .

copa:dataPartida a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "dataPartida" ;
    rdfs:domain copa:Partida ;
    rdfs:range xsd:date ;
    rdfs:comment "Funcional: uma partida ocorre em uma unica data." .

copa:golsMandante a owl:DatatypeProperty ;
    rdfs:label "golsMandante" ;
    rdfs:domain copa:Partida ;
    rdfs:range xsd:integer ;
    rdfs:comment "Gols do mandante no tempo normal somado a prorrogacao." .

copa:golsVisitante a owl:DatatypeProperty ;
    rdfs:label "golsVisitante" ;
    rdfs:domain copa:Partida ;
    rdfs:range xsd:integer ;
    rdfs:comment "Gols do visitante no tempo normal somado a prorrogacao." .

copa:publico a owl:DatatypeProperty ;
    rdfs:label "publico" ;
    rdfs:domain copa:Partida ;
    rdfs:range xsd:integer ;
    rdfs:comment "Publico presente, segundo o relatorio oficial da FIFA." .

copa:letraGrupo a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "letraGrupo" ;
    rdfs:domain copa:Grupo ;
    rdfs:range xsd:string ;
    rdfs:comment "Letra que identifica a chave, de A a L." .

copa:posicaoNoGrupo a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "posicaoNoGrupo" ;
    rdfs:domain copa:Selecao ;
    rdfs:range xsd:integer ;
    rdfs:comment "Colocacao final da selecao na sua chave, de 1 a 4." .

# OWL 6 e 7 - owl:FunctionalProperty + owl:InverseFunctionalProperty
# O codigo FIFA e uma chave global: cada selecao tem exatamente um (funcional)
# e cada codigo pertence a uma so selecao (inversamente funcional). Duas bases
# que usem 'BRA' falam da mesma selecao, e o reasoner deriva owl:sameAs.
copa:codigoFIFA a owl:DatatypeProperty ,
        owl:FunctionalProperty ,
        owl:InverseFunctionalProperty ;
    rdfs:label "codigoFIFA" ;
    rdfs:domain copa:Selecao ;
    rdfs:range xsd:string ;
    rdfs:comment "Codigo de tres letras da FIFA; identifica a selecao globalmente." .


# ============================================================================
# A-BOX 1/6 - GEOGRAFIA: 3 paises, 16 cidades-sede, 16 estadios
# ============================================================================

# A ligacao estadio -> pais nao e escrita; vem da transitividade.

copa:pais_CAN a copa:Pais ; rdfs:label "Canadá" .
copa:pais_USA a copa:Pais ; rdfs:label "Estados Unidos" .
copa:pais_MEX a copa:Pais ; rdfs:label "México" .

copa:cidade_atlanta a copa:CidadeSede ; rdfs:label "Atlanta" ; copa:localizadoEm copa:pais_USA .
copa:cidade_boston a copa:CidadeSede ; rdfs:label "Boston" ; copa:localizadoEm copa:pais_USA .
copa:cidade_cidade_do_mexico a copa:CidadeSede ; rdfs:label "Cidade do México" ; copa:localizadoEm copa:pais_MEX .
copa:cidade_dallas a copa:CidadeSede ; rdfs:label "Dallas" ; copa:localizadoEm copa:pais_USA .
